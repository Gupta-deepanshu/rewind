# Copy this file to .env.local and fill in ONE of the two TMDB credentials.
# Get them free at https://www.themoviedb.org/settings/api (needs a TMDB account).
# Without a key the site runs on the built-in example data.

# The "API Read Access Token" (long token, preferred)
TMDB_READ_ACCESS_TOKEN=

# ...or the short "API Key"
TMDB_API_KEY=

# Optional. api.tmdb.org is TMDB's alternative host, used because api.themoviedb.org
# is blocked by some internet providers.
# TMDB_API_BASE=https://api.tmdb.org/3

# ---------- Ask the clerk (AI search, optional) ----------
# A free key for either provider, or both. With both, the clerk asks one and, if it's out of
# quota, busy or down, the other. Without any, it understands requests with simple rules and
# falls back to a title search.

# Groq: https://console.groq.com/keys (free tier; asked first by default)
GROQ_API_KEY=

# Google Gemini: https://aistudio.google.com, "Get API key" (free tier; about 20 requests a day)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Which provider to ask first ("groq" or "google"; default groq), and a model other
# than the defaults (openai/gpt-oss-120b on Groq, gemini-3.5-flash on Google).
# AI_PROVIDER=groq
# GROQ_MODEL=openai/gpt-oss-120b
# GOOGLE_MODEL=gemini-3.5-flash
