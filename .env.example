# Copy this file to .env.local and fill in ONE of the two TMDB credentials.
# Get them free at https://www.themoviedb.org/settings/api (needs a TMDB account).
# Without a key the site runs on the built-in example data.

# The "API Read Access Token" (long token, preferred)
TMDB_READ_ACCESS_TOKEN=

# ...or the short "API Key"
TMDB_API_KEY=

# Optional. api.tmdb.org is TMDB's alternative host, used because api.themoviedb.org
# is blocked by some internet providers.
# TMDB_API_BASE=https://api.tmdb.org/3
